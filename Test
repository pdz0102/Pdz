--// Custom Shift Lock UI + Crosshair "+"
-- Đặt trong StarterPlayer > StarterPlayerScripts (LocalScript)

local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local PlayerGui = player:WaitForChild("PlayerGui")

-- ===== CONFIG =====
local TOGGLE_KEY = Enum.KeyCode.LeftShift
local isShiftLock = false
local debounce = false

-- UI Setup
local gui = Instance.new("ScreenGui")
gui.Name = "ShiftLockSystem"
gui.ResetOnSpawn = false
gui.Parent = PlayerGui

-- Nút tròn
local button = Instance.new("ImageButton")
button.Name = "ShiftLockButton"
button.Size = UDim2.new(0, 60, 0, 60)
button.Position = UDim2.new(1, -80, 1, -100)
button.AnchorPoint = Vector2.new(0.5, 0.5)
button.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
button.BorderSizePixel = 0
button.AutoButtonColor = false
button.Image = ""
button.BackgroundTransparency = 0.2
button.Parent = gui

local uicorner = Instance.new("UICorner")
uicorner.CornerRadius = UDim.new(1, 0)
uicorner.Parent = button

local label = Instance.new("TextLabel")
label.Size = UDim2.new(1, 0, 1, 0)
label.BackgroundTransparency = 1
label.Text = "SHIFT"
label.Font = Enum.Font.GothamBold
label.TextColor3 = Color3.fromRGB(255, 255, 255)
label.TextScaled = true
label.Parent = button

-- Crosshair "+"
local color = Color3.fromRGB(255, 255, 255)
local lineLength = 16
local thickness = 2
local centerX, centerY = 0.5, 0.5

local horizontal = Instance.new("Frame")
horizontal.Size = UDim2.new(0, lineLength, 0, thickness)
horizontal.AnchorPoint = Vector2.new(0.5, 0.5)
horizontal.Position = UDim2.new(centerX, 0, centerY, 0)
horizontal.BackgroundColor3 = color
horizontal.BorderSizePixel = 0
horizontal.Visible = false
horizontal.Parent = gui

local vertical = Instance.new("Frame")
vertical.Size = UDim2.new(0, thickness, 0, lineLength)
vertical.AnchorPoint = Vector2.new(0.5, 0.5)
vertical.Position = UDim2.new(centerX, 0, centerY, 0)
vertical.BackgroundColor3 = color
vertical.BorderSizePixel = 0
vertical.Visible = false
vertical.Parent = gui

-- ===== FUNCTIONS =====
local function setCrossVisible(state)
	horizontal.Visible = state
	vertical.Visible = state
end

local function applyShiftLock(state)
	if state then
		pcall(function()
			player.CameraMode = Enum.CameraMode.LockFirstPerson
		end)
		setCrossVisible(true)
		button.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
	else
		pcall(function()
			player.CameraMode = Enum.CameraMode.Classic
		end)
		setCrossVisible(false)
		button.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	end
end

local function toggle()
	if debounce then return end
	debounce = true
	isShiftLock = not isShiftLock
	applyShiftLock(isShiftLock)
	task.wait(0.25)
	debounce = false
end

-- ===== INPUTS =====
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == TOGGLE_KEY then
		toggle()
	end
end)

button.MouseButton1Click:Connect(function()
	toggle()
end)

-- ===== DRAGGING =====
local dragging = false
local dragStart, startPos

local function update(input)
	local delta = input.Position - dragStart
	button.Position = UDim2.new(
		startPos.X.Scale,
		startPos.X.Offset + delta.X,
		startPos.Y.Scale,
		startPos.Y.Offset + delta.Y
	)
end

button.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = button.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		update(input)
	end
end)

-- Reset on spawn
player.CharacterAdded:Connect(function()
	isShiftLock = false
	applyShiftLock(isShiftLock)
end)

applyShiftLock(isShiftLock)
